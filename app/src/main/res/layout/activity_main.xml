<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp">
    <androidx.appcompat.widget.Toolbar android:id="@+id/navigationToolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/pantry_title" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/pantry_subtitle" android:layout_marginTop="8dp"/>
    <Button android:id="@+id/addIngredient" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/add_ingredient"/>
    <TextView android:id="@+id/emptyPantry" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="24dp" android:text="@string/empty_pantry"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/pantryList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="12dp"/>
</LinearLayout>
